{
  "name": "shadcn/ui",
  "version": 1,
  "source": "https://ui.shadcn.com/docs/theming (default neutral theme, checked 2026-11-19)",
  "color": {
    "themes": [
      { "id": "light", "name": "Light" },
      { "id": "dark", "name": "Dark" }
    ],
    "note": "Light is the primary theme. Every surface token pairs with a -foreground token for the text and icons on it. Neutral greys carry the UI; colour appears only in destructive, charts and the dark sidebar-primary.",
    "tokens": [
      { "name": "background", "value": { "light": "oklch(1 0 0)", "dark": "oklch(0.145 0 0)" }, "usage": "Page background and default control fill." },
      { "name": "foreground", "value": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" }, "usage": "Default text and icons on background." },
      { "name": "card", "value": { "light": "oklch(1 0 0)", "dark": "oklch(0.205 0 0)" }, "usage": "Cards and panels. Same as background in light; one step up in dark." },
      { "name": "card-foreground", "value": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" }, "usage": "Text on card." },
      { "name": "popover", "value": { "light": "oklch(1 0 0)", "dark": "oklch(0.205 0 0)" }, "usage": "Menus, popovers, dialogs: anything that floats." },
      { "name": "popover-foreground", "value": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" }, "usage": "Text on popover." },
      { "name": "primary", "value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.922 0 0)" }, "usage": "The main action: near-black in light, near-white in dark. Default button, checked controls, progress fill." },
      { "name": "primary-foreground", "value": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.205 0 0)" }, "usage": "Text on primary." },
      { "name": "secondary", "value": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" }, "usage": "Lower-emphasis filled buttons and badges." },
      { "name": "secondary-foreground", "value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.985 0 0)" }, "usage": "Text on secondary." },
      { "name": "muted", "value": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" }, "usage": "Subdued surfaces: tab list track, kbd, inline code, table footer, avatar fallback." },
      { "name": "muted-foreground", "value": { "light": "oklch(0.556 0 0)", "dark": "oklch(0.708 0 0)" }, "usage": "Descriptions, helper text, placeholders, meta. 4.7:1 on background in light but only about 4.4:1 on muted, so keep body-size muted text off muted surfaces." },
      { "name": "accent", "value": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" }, "usage": "Hover and highlight wash: ghost and outline buttons on hover, focused menu items, skeletons. Not a brand colour." },
      { "name": "accent-foreground", "value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.985 0 0)" }, "usage": "Text on accent." },
      { "name": "destructive", "value": { "light": "oklch(0.577 0.245 27.325)", "dark": "oklch(0.704 0.191 22.216)" }, "usage": "Delete actions, errors, invalid fields. The only built-in semantic hue." },
      { "name": "border", "value": { "light": "oklch(0.922 0 0)", "dark": "oklch(1 0 0 / 10%)" }, "usage": "Every default 1px border and separator: cards, tables, menus." },
      { "name": "input", "value": { "light": "oklch(0.922 0 0)", "dark": "oklch(1 0 0 / 15%)" }, "usage": "Form control borders. In dark, also a 30% fill behind inputs and outline buttons." },
      { "name": "ring", "value": { "light": "oklch(0.708 0 0)", "dark": "oklch(0.556 0 0)" }, "usage": "Focus: the control's border turns ring and a 3px ring at 50% surrounds it." },
      { "name": "chart-1", "value": { "light": "oklch(0.646 0.222 41.116)", "dark": "oklch(0.488 0.243 264.376)" }, "usage": "Chart series 1. Charts only." },
      { "name": "chart-2", "value": { "light": "oklch(0.6 0.118 184.704)", "dark": "oklch(0.696 0.17 162.48)" }, "usage": "Chart series 2." },
      { "name": "chart-3", "value": { "light": "oklch(0.398 0.07 227.392)", "dark": "oklch(0.769 0.188 70.08)" }, "usage": "Chart series 3." },
      { "name": "chart-4", "value": { "light": "oklch(0.828 0.189 84.429)", "dark": "oklch(0.627 0.265 303.9)" }, "usage": "Chart series 4." },
      { "name": "chart-5", "value": { "light": "oklch(0.769 0.188 70.08)", "dark": "oklch(0.645 0.246 16.439)" }, "usage": "Chart series 5." },
      { "name": "sidebar", "value": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.205 0 0)" }, "usage": "App sidebar surface: a shade off background." },
      { "name": "sidebar-foreground", "value": { "light": "oklch(0.145 0 0)", "dark": "oklch(0.985 0 0)" }, "usage": "Sidebar text." },
      { "name": "sidebar-primary", "value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.488 0.243 264.376)" }, "usage": "Sidebar logo tile and high-emphasis items. Blue in dark." },
      { "name": "sidebar-primary-foreground", "value": { "light": "oklch(0.985 0 0)", "dark": "oklch(0.985 0 0)" }, "usage": "Text on sidebar-primary." },
      { "name": "sidebar-accent", "value": { "light": "oklch(0.97 0 0)", "dark": "oklch(0.269 0 0)" }, "usage": "Hovered and active sidebar items." },
      { "name": "sidebar-accent-foreground", "value": { "light": "oklch(0.205 0 0)", "dark": "oklch(0.985 0 0)" }, "usage": "Text on sidebar-accent." },
      { "name": "sidebar-border", "value": { "light": "oklch(0.922 0 0)", "dark": "oklch(1 0 0 / 10%)" }, "usage": "Sidebar edge and dividers." },
      { "name": "sidebar-ring", "value": { "light": "oklch(0.708 0 0)", "dark": "oklch(0.556 0 0)" }, "usage": "Focus ring inside the sidebar." },
      { "name": "input-bg", "derived": true, "value": { "light": "transparent", "dark": "oklch(1 0 0 / 4.5%)" }, "usage": "Fill of inputs, textareas, selects, checkboxes (shadcn: dark:bg-input/30)." },
      { "name": "outline-bg", "derived": true, "value": { "light": "var(--background)", "dark": "oklch(1 0 0 / 4.5%)" }, "usage": "Outline button fill (dark:bg-input/30)." },
      { "name": "outline-bg-hover", "derived": true, "value": { "light": "var(--accent)", "dark": "oklch(1 0 0 / 7.5%)" }, "usage": "Outline button hover (dark:hover:bg-input/50)." },
      { "name": "outline-border", "derived": true, "value": { "light": "var(--border)", "dark": "var(--input)" }, "usage": "Outline button border (dark:border-input)." },
      { "name": "ghost-hover", "derived": true, "value": { "light": "var(--accent)", "dark": "oklch(0.269 0 0 / 50%)" }, "usage": "Ghost button hover (dark:hover:bg-accent/50)." },
      { "name": "destructive-fill", "derived": true, "value": { "light": "var(--destructive)", "dark": "oklch(0.704 0.191 22.216 / 60%)" }, "usage": "Destructive button and badge fill (dark:bg-destructive/60). Text on it is white." },
      { "name": "switch-track", "derived": true, "value": { "light": "var(--input)", "dark": "oklch(1 0 0 / 12%)" }, "usage": "Unchecked switch track (dark:bg-input/80)." },
      { "name": "switch-thumb", "derived": true, "value": { "light": "var(--background)", "dark": "var(--foreground)" }, "usage": "Unchecked switch thumb." },
      { "name": "switch-thumb-checked", "derived": true, "value": { "light": "var(--background)", "dark": "var(--primary-foreground)" }, "usage": "Checked switch thumb." },
      { "name": "tab-active-bg", "derived": true, "value": { "light": "var(--background)", "dark": "oklch(1 0 0 / 4.5%)" }, "usage": "Selected tab trigger fill." },
      { "name": "tab-active-border", "derived": true, "value": { "light": "transparent", "dark": "var(--input)" }, "usage": "Selected tab trigger border." }
    ]
  },
  "radius": {
    "note": "One base token; the scale derives from it, so changing --radius reshapes everything.",
    "tokens": [
      { "name": "radius", "value": "0.625rem", "usage": "Base radius (10px)." },
      { "name": "radius-sm", "value": "calc(var(--radius) * 0.6)", "usage": "6px: menu items, kbd, tooltips' arrow." },
      { "name": "radius-md", "value": "calc(var(--radius) * 0.8)", "usage": "8px: buttons, inputs, menus, tab triggers, skeletons." },
      { "name": "radius-lg", "value": "var(--radius)", "usage": "10px: alerts, dialogs, tab lists." },
      { "name": "radius-xl", "value": "calc(var(--radius) * 1.4)", "usage": "14px: cards." },
      { "name": "radius-full", "value": "9999px", "usage": "Badges, avatars, switches, progress bars." }
    ]
  },
  "spacing": {
    "note": "Tailwind's 4px scale. The bundle uses these names; 'space-6' means Tailwind's p-6.",
    "tokens": [
      { "name": "space-1", "value": "0.25rem" },
      { "name": "space-1-5", "value": "0.375rem" },
      { "name": "space-2", "value": "0.5rem" },
      { "name": "space-3", "value": "0.75rem" },
      { "name": "space-4", "value": "1rem" },
      { "name": "space-6", "value": "1.5rem" },
      { "name": "space-8", "value": "2rem" },
      { "name": "space-10", "value": "2.5rem" },
      { "name": "space-12", "value": "3rem" },
      { "name": "space-16", "value": "4rem" }
    ]
  },
  "shadow": {
    "note": "Tailwind v4 shadows. Shadows are faint; borders do the separating.",
    "tokens": [
      { "name": "shadow-xs", "value": "0 1px 2px 0 rgb(0 0 0 / 0.05)", "usage": "Inputs, outline buttons, switches." },
      { "name": "shadow-sm", "value": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)", "usage": "Cards, active tab trigger." },
      { "name": "shadow-md", "value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)", "usage": "Dropdown menus, popovers." },
      { "name": "shadow-lg", "value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)", "usage": "Dialogs, sheets." }
    ]
  },
  "type": {
    "families": {
      "sans": "\"Geist\", ui-sans-serif, system-ui, -apple-system, sans-serif",
      "mono": "\"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
    },
    "groups": [
      {
        "name": "Headings",
        "styles": [
          { "name": "h1", "fontSize": "2.25rem", "lineHeight": "2.5rem", "fontWeight": 800, "letterSpacing": "-0.025em" },
          { "name": "h2", "fontSize": "1.875rem", "lineHeight": "2.25rem", "fontWeight": 600, "letterSpacing": "-0.025em" },
          { "name": "h3", "fontSize": "1.5rem", "lineHeight": "2rem", "fontWeight": 600, "letterSpacing": "-0.025em" },
          { "name": "h4", "fontSize": "1.25rem", "lineHeight": "1.75rem", "fontWeight": 600, "letterSpacing": "-0.025em" }
        ]
      },
      {
        "name": "Text",
        "styles": [
          { "name": "lead", "fontSize": "1.25rem", "lineHeight": "1.75rem", "fontWeight": 400 },
          { "name": "large", "fontSize": "1.125rem", "lineHeight": "1.75rem", "fontWeight": 600 },
          { "name": "body", "fontSize": "1rem", "lineHeight": "1.75rem", "fontWeight": 400 },
          { "name": "small", "fontSize": "0.875rem", "lineHeight": "1.25rem", "fontWeight": 500 },
          { "name": "ui", "fontSize": "0.875rem", "lineHeight": "1.25rem", "fontWeight": 400 },
          { "name": "xs", "fontSize": "0.75rem", "lineHeight": "1rem", "fontWeight": 500 },
          { "name": "mono", "fontSize": "0.875rem", "lineHeight": "1.25rem", "fontWeight": 600 }
        ]
      }
    ]
  }
}
